<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="QXX Proxy With Origin" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_ORIGIN}" pattern=".+" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8774/{R:1}" />
          <serverVariables>
            <set name="HTTP_HOST" value="127.0.0.1:8774" />
            <set name="HTTP_ORIGIN" value="http://127.0.0.1:8774" />
          </serverVariables>
        </rule>
        <rule name="QXX Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8774/{R:1}" />
          <serverVariables>
            <set name="HTTP_HOST" value="127.0.0.1:8774" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
